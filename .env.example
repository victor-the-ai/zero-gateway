# Zerogateway - API Keys Configuration
# Leave blank any providers you do not use. Providers without keys are skipped or use zero-auth.

# Groq (Free at https://console.groq.com/keys)
GROQ_API_KEY=""

# Cerebras (Free at https://cloud.cerebras.ai/platform/)
CEREBRAS_API_KEY=""

# SambaNova (Free at https://cloud.sambanova.ai/apis)
SAMBANOVA_API_KEY=""

# Google AI Studio (Free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# OpenRouter Free Models (Free at https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=""

# Mistral AI Free Tier (Free at https://console.mistral.ai/api-keys/)
MISTRAL_API_KEY=""

# GitHub Models (Free Personal Access Token at https://github.com/settings/tokens)
GITHUB_TOKEN=""

# Zerogateway Settings
ZERO_GATEWAY_REGISTRY_URL="https://raw.githubusercontent.com/zerogateway/zero-gateway/main/registry/index.json"
ZERO_GATEWAY_CACHE_DIR="~/.cache/zerogateway"
ZERO_GATEWAY_PROXY_PORT=8080
ZERO_GATEWAY_TIMEOUT=30.0
