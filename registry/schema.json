{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FreeLLMProvider",
  "description": "Schema definition for a free or promotional LLM provider",
  "type": "object",
  "required": ["id", "name", "website", "status", "tier", "api", "models"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$",
      "description": "Unique identifier for the provider (e.g. groq, cerebras)"
    },
    "name": {
      "type": "string",
      "description": "Human-readable display name"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "console_url": {
      "type": "string",
      "format": "uri",
      "description": "Direct URL to get API keys or access"
    },
    "status": {
      "type": "string",
      "enum": ["active", "degraded", "expired", "unverified"],
      "description": "Current availability status of the free tier or promotion"
    },
    "tier": {
      "type": "object",
      "required": ["type", "requires_credit_card", "auth_type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["permanent_free", "promotional_credit", "waitlist_beta", "no_key_required"]
        },
        "requires_credit_card": {
          "type": "boolean"
        },
        "auth_type": {
          "type": "string",
          "enum": ["api_key", "oauth2", "none"]
        },
        "signup_methods": {
          "type": "array",
          "items": { "type": "string" }
        },
        "promo_details": {
          "type": "object",
          "properties": {
            "expires_at": {
              "type": ["string", "null"],
              "description": "ISO date string or null if ongoing"
            },
            "initial_credits_usd": {
              "type": "number",
              "default": 0
            },
            "promo_code": {
              "type": ["string", "null"]
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "api": {
      "type": "object",
      "required": ["format", "base_url"],
      "properties": {
        "format": {
          "type": "string",
          "enum": ["openai_compatible", "gemini_native", "anthropic_native", "custom"]
        },
        "base_url": {
          "type": "string",
          "format": "uri"
        },
        "env_var": {
          "type": ["string", "null"],
          "description": "Environment variable storing user API key"
        },
        "default_headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "requests_per_minute": { "type": ["number", "null"] },
        "requests_per_day": { "type": ["number", "null"] },
        "tokens_per_minute": { "type": ["number", "null"] },
        "tokens_per_day": { "type": ["number", "null"] },
        "concurrency": { "type": ["number", "null"] }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Exact model identifier passed in API requests"
          },
          "display_name": { "type": "string" },
          "aliases": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Generic aliases like llama-3.3-70b, fast-code, etc."
          },
          "context_window": { "type": ["number", "null"] },
          "supports_tools": { "type": "boolean", "default": false },
          "supports_vision": { "type": "boolean", "default": false },
          "supports_streaming": { "type": "boolean", "default": true }
        }
      }
    }
  }
}
